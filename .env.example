# Токен от @BotFather
BOT_TOKEN=123456789:AA...

# Кому слать уведомления о записях (Telegram ID через запятую). Узнать свой ID: команда /id в боте
OWNER_IDS=

# Какие заведения обслуживает бот (файлы из папки presets/). Если указать несколько — бот
# предложит выбрать заведение (удобно для демо в портфолио или сети салонов)
PRESETS=barbershop
# PRESETS=barbershop,tattoo,autoservice,nails

# Где хранить записи: local (JSON-файл в data/, для теста) или sheets (Google Таблица)
STORAGE=local
SPREADSHEET_ID=
GOOGLE_CREDENTIALS_FILE=credentials.json

TIMEZONE=Europe/Moscow
BOOKING_DAYS_AHEAD=14
# Минимум минут от «сейчас» до записи (чтобы не записывались на «через 5 минут»)
MIN_LEAD_MINUTES=60
# Сколько активных записей может быть у одного клиента (защита от спама)
MAX_ACTIVE_PER_USER=3
# Регион по умолчанию для номеров без кода страны
PHONE_REGION=RU

# Демо-режим: клиент видит копию уведомления, которое получил владелец
DEMO_MODE=false
